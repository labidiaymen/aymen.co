---
layout: layouts/base.njk
title: "Search"
description: "Search every post on aymen.co."
permalink: /search/
eleventyExcludeFromCollections: true
---
<section class="container page">
  <header class="page-head">
    <h1>Search</h1>
    <p class="page-lead">Across all {{ collections.posts.length }} posts.</p>
  </header>
  <div id="search" data-pagefind-ignore></div>
</section>

<link href="/pagefind/pagefind-ui.css" rel="stylesheet">
<script src="/pagefind/pagefind-ui.js"></script>
<script>
  window.addEventListener("DOMContentLoaded", function () {
    new PagefindUI({
      element: "#search",
      showImages: false,
      showSubResults: true,
      resetStyles: false,
      translations: { placeholder: "Search posts", zero_results: "Nothing found for [SEARCH_TERM]" },
    });
  });
</script>
