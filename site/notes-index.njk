---
layout: layouts/base.njk
title: "Notes"
description: "Short notes between the essays: releases, findings, opinions."
permalink: /notes/
---
<section class="container page">
  <header class="page-head">
    <h1>Notes</h1>
    <p class="page-lead">Short posts between the essays: releases, findings, opinions. The longer thinking lives in the <a href="/blog/">writing</a>.</p>
  </header>
  {%- if not collections.notes.length %}
  <p class="page-lead">Nothing here yet.</p>
  {%- endif %}
  <div class="note-stream">
    {%- for note in collections.notes %}
    {#- With a title the heading is the link; without one the date has to be,
        otherwise an untitled note has no way to reach its own page. #}
    {%- set titled = note.data.title %}
    <article class="note-entry">
      <a class="note-date" href="{{ note.url }}"{% if titled %} tabindex="-1" aria-hidden="true"{% endif %}>
        <time datetime="{{ note.date | isoDate }}">
          <span class="note-day">{{ note.date | dayStamp }}</span>
          <span class="note-year">{{ note.date | year }}</span>
        </time>
        {%- if not titled %}<span class="visually-hidden">Permalink to this note</span>{% endif %}
      </a>
      <div class="note-entry-body">
        {%- if titled %}
        <h2 class="note-heading"><a href="{{ note.url }}">{{ note.data.title }}</a></h2>
        {%- endif %}
        <div class="note-body prose{% if not titled %} note-body-lead{% endif %}">
          {{ note.templateContent | noteTeaser | safe }}
        </div>
        {%- if note.templateContent | isLongNote %}
        <p class="note-more"><a href="{{ note.url }}">Read the rest</a></p>
        {%- endif %}
      </div>
    </article>
    {%- endfor %}
  </div>
</section>
