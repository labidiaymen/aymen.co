---
layout: layouts/base.njk
title: "Writing"
description: "All posts — AI agents, software architecture, JavaScript, and more."
permalink: /blog/
---
<section class="page-title">
  <div class="container">
    <h1>Writing<span class="title-index">/{{ collections.posts.length }}</span></h1>
  </div>
  <div class="spec-row">
    <div class="container filter-cols">
      <span>Filed under</span>
      <span class="filter-links">
        {%- for group in collections.categoryMap | limit(9) %}
        <a href="/{{ group.slug }}/">{{ group.label }}&nbsp;({{ group.posts.length }})</a>
        {%- endfor %}
      </span>
    </div>
  </div>
</section>

<section class="container">
  {%- for group in collections.posts | groupByYear %}
  <h2 class="year-bar">{{ group.year }}</h2>
  {%- set posts = group.posts %}
  {% include "post-list.njk" %}
  {%- endfor %}
</section>
