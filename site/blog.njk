---
layout: layouts/base.njk
title: "Writing"
description: "All posts on AI agents, software architecture, JavaScript, and more."
permalink: /blog/
---
<section class="container page">
  <header class="page-head">
    <h1>Writing</h1>
    <p class="page-lead">{{ collections.posts.length }} posts since 2015, lately about AI agents and how software actually gets shipped.</p>
    <p class="filter-line">Filed under
      {%- for group in collections.categoryMap | limit(8) %}
      <a href="/{{ group.slug }}/">{{ group.label }}</a>{% if not loop.last %} · {% endif %}
      {%- endfor %}
    </p>
  </header>

  {#- Parts of a series sit scattered by date below, so they get a way in here. #}
  {%- set allSeries = collections.series | seriesList %}
  {%- if allSeries.length %}
  <section class="writing-series">
    <h2 class="rule-heading">Series</h2>
    <ul class="post-list">
      {%- for item in allSeries %}
      <li class="post-row">
        <a class="post-row-link" href="{{ item.first.url }}">
          <span class="post-row-title">{{ item.name }}</span>
          <span class="post-row-leader" aria-hidden="true"></span>
          <span class="post-row-meta">{{ item.total }} parts</span>
        </a>
      </li>
      {%- endfor %}
    </ul>
  </section>
  {%- endif %}

  {%- for group in collections.posts | groupByYear %}
  <div class="year-block">
    <span class="year-label">{{ group.year }}</span>
    <div class="year-posts">
      {%- set posts = group.posts %}
      {% include "post-list.njk" %}
    </div>
  </div>
  {%- endfor %}
</section>
