---
layout: layouts/base.njk
pagination:
  data: collections.categoryPages
  size: 1
  alias: category
permalink: "/{{ category.slug }}/"
eleventyComputed:
  title: "{{ category.label }}"
  description: "Posts about {{ category.label }} by Labidi Aymen."
---
<section class="page-title">
  <div class="container">
    <h1>{{ category.label }}<span class="title-index">/{{ category.posts.length }}</span></h1>
  </div>
  <div class="spec-row">
    <div class="container filter-cols">
      <span><a href="/blog/">← Full index</a></span>
      <span>{{ category.posts.length }} post{% if category.posts.length != 1 %}s{% endif %}</span>
    </div>
  </div>
</section>

<section class="container">
  {%- set posts = category.posts %}
  {% include "post-list.njk" %}
</section>
