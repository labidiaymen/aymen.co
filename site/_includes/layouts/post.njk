---
layout: layouts/base.njk
---
<article class="post">
  <header class="post-title-block">
    <div class="container">
      <p class="post-kicker">
        {%- for cat in categories %}<a href="/{{ cat }}/">{{ cat | categoryLabel }}</a>{% if not loop.last %} · {% endif %}{%- endfor %}
      </p>
      <h1 class="post-title">{{ title }}</h1>
      {%- if description %}
      <p class="post-description">{{ description }}</p>
      {%- endif %}
    </div>
    <div class="spec-row">
      <div class="container filter-cols">
        <span>No. {{ num }}</span>
        <time datetime="{{ page.date | isoDate }}">{{ page.date | readableDate }}</time>
        <span>{{ content | readingTime }} min read</span>
      </div>
    </div>
  </header>
  <div class="container post-body">
    {%- if cover %}
    <img class="post-cover" src="{{ cover }}" alt="" loading="eager">
    {%- endif %}
    <div class="prose">
      {{ content | safe }}
    </div>
  </div>
  <nav class="post-nav" aria-label="More writing">
    <div class="container">
      <a href="/blog/">← Index</a>
    </div>
  </nav>
</article>
