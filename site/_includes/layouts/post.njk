---
layout: layouts/base.njk
---
<article class="container post">
  <header class="post-header">
    <div class="post-meta">
      {%- for cat in categories %}
      <a class="chip" href="/{{ cat }}/">{{ cat | categoryLabel }}</a>
      {%- endfor %}
      <time datetime="{{ page.date | isoDate }}">{{ page.date | readableDate }}</time>
      <span class="meta-sep">·</span>
      <span>{{ content | readingTime }} min read</span>
    </div>
    <h1 class="post-title">{{ title }}</h1>
    {%- if description %}
    <p class="post-description">{{ description }}</p>
    {%- endif %}
  </header>
  {%- if cover %}
  <img class="post-cover" src="{{ cover }}" alt="{{ title }}" loading="eager" decoding="sync" fetchpriority="high">
  {%- endif %}
  {%- set thisSeries = collections.series | seriesInfo(series, page.url) %}
  {%- if thisSeries.total > 1 %}
  <aside class="post-series" aria-label="Posts in this series">
    <p class="series-kicker">{{ series }} · Part {{ thisSeries.number }} of {{ thisSeries.total }}</p>
    <ol class="series-parts">
      {%- for part in thisSeries.parts %}
      {%- if part.url == page.url %}
      <li class="series-current" aria-current="true"><span>{{ part.data.title }}</span></li>
      {%- else %}
      <li><a href="{{ part.url }}">{{ part.data.title }}</a></li>
      {%- endif %}
      {%- endfor %}
    </ol>
  </aside>
  {%- endif %}

  {%- set toc = content | headings %}
  {%- if toc.length >= 4 %}
  <nav class="post-toc" aria-label="On this page">
    <p class="toc-label">On this page</p>
    <ol>
      {%- for h in toc %}
      <li class="toc-h{{ h.level }}"><a href="#{{ h.id }}">{{ h.text }}</a></li>
      {%- endfor %}
    </ol>
  </nav>
  <script>
    // Marks the section you are currently reading in the contents list.
    // Deferred: the headings this looks up are parsed after this script.
    document.addEventListener("DOMContentLoaded", function () {
      var pairs = [];
      document.querySelectorAll(".post-toc a").forEach(function (link) {
        var target = document.getElementById(decodeURIComponent(link.hash.slice(1)));
        if (target) pairs.push({ link: link, target: target });
      });
      if (!pairs.length) return;

      var pending = false;
      function update() {
        pending = false;
        var line = window.scrollY + 140;
        var current = 0;
        for (var i = 0; i < pairs.length; i++) {
          if (pairs[i].target.getBoundingClientRect().top + window.scrollY <= line) current = i;
        }
        // At the very bottom the last section is the one being read.
        if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 60) {
          current = pairs.length - 1;
        }
        pairs.forEach(function (pair, i) {
          pair.link.classList.toggle("is-current", i === current);
          if (i === current) pair.link.setAttribute("aria-current", "true");
          else pair.link.removeAttribute("aria-current");
        });
      }

      addEventListener("scroll", function () {
        if (!pending) { pending = true; requestAnimationFrame(update); }
      }, { passive: true });
      addEventListener("resize", update);
      update();
    });
  </script>
  {%- endif %}
  <div class="prose" data-pagefind-body>
    {{ content | safe }}
  </div>

  {%- if thisSeries.next %}
  <p class="series-next">
    <span class="series-next-label">Next in {{ series }}</span>
    <a href="{{ thisSeries.next.url }}">{{ thisSeries.next.data.title }}</a>
  </p>
  {%- endif %}

  {%- set neighbours = collections.posts | adjacent(page.url) %}
  <nav class="post-pagination" aria-label="Adjacent posts">
    {%- if neighbours.older %}
    <a class="pag-older" href="{{ neighbours.older.url }}">
      <span class="pag-label">← Older</span>
      <span class="pag-title">{{ neighbours.older.data.title }}</span>
    </a>
    {%- else %}<span></span>{%- endif %}
    {%- if neighbours.newer %}
    <a class="pag-newer" href="{{ neighbours.newer.url }}">
      <span class="pag-label">Newer →</span>
      <span class="pag-title">{{ neighbours.newer.data.title }}</span>
    </a>
    {%- endif %}
  </nav>

  {%- set relatedPosts = collections.posts | related(page.url, categories) %}
  {%- if relatedPosts.length %}
  <aside class="post-related">
    <h2 class="rule-heading">More in {{ categories[0] | categoryLabel }}</h2>
    {%- set posts = relatedPosts %}
    {% include "post-list.njk" %}
  </aside>
  {%- endif %}

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": {{ title | dump | safe }},
    "datePublished": "{{ page.date | isoDate }}",
    "url": "{{ page.url | absoluteUrl(site.url) }}",
    {%- if description %}
    "description": {{ description | dump | safe }},
    {%- endif %}
    {%- set structuredImage = cover or thumb %}
    {%- if structuredImage %}
    "image": "{{ structuredImage | absoluteUrl(site.url) }}",
    {%- endif %}
    "author": { "@type": "Person", "name": "{{ site.author }}", "url": "{{ site.url }}/about/" }
  }
  </script>
</article>
