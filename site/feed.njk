---
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.title }}</title>
    <link>{{ site.url }}/</link>
    <description>{{ site.description }}</description>
    <language>en</language>
    <atom:link href="{{ site.url }}/feed.xml" rel="self" type="application/rss+xml"/>
    {%- for post in collections.posts | limit(20) %}
    <item>
      <title>{{ post.data.title }}</title>
      <link>{{ post.url | absoluteUrl(site.url) }}</link>
      <guid>{{ post.url | absoluteUrl(site.url) }}</guid>
      <pubDate>{{ post.date | rssDate }}</pubDate>
      {%- if post.data.description %}
      <description>{{ post.data.description }}</description>
      {%- else %}
      <description>{{ post.templateContent | excerpt }}</description>
      {%- endif %}
    </item>
    {%- endfor %}
  </channel>
</rss>
