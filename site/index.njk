---
layout: layouts/base.njk
---
<section class="container home-intro">
  <h1 class="intro-name">Labidi Aymen</h1>
  <p class="intro-role">Architect &amp; Engineering Manager <a href="https://www.inetum.com/" rel="noopener" target="_blank">@Inetum</a> · Founder of Nuraly · Tunisia</p>
  <div class="intro-prose">
    <p>
      Building for the web since 2010. I lead a team of 20 at <a href="https://www.inetum.com/" rel="noopener" target="_blank">Inetum</a> and write
      here about running <a href="/ai/">AI&nbsp;agents in production</a>,
      beyond the demo.
    </p>
  </div>
  <p class="intro-currently">
    Currently: building <a href="https://joule.sh/" rel="noopener" target="_blank">Joule</a>, an agent AI platform
    · <a href="https://lumen-lang.org/" rel="noopener" target="_blank">Lumen</a>, a TypeScript-syntax language
    that compiles to a native binary
    · shipping code with AI agents at <a href="/ai/nuraly-how-we-ship-code-with-ai-agents/">Nuraly</a>
  </p>
</section>

<section class="container home-section">
  <h2 class="rule-heading">Writing</h2>
  {#- The two most recent posts lead with their picture; the rest are ledger rows. #}
  {%- for item in collections.posts | limit(2) %}
  <a class="featured-item" href="{{ item.data.external or item.url }}"{% if item.data.external %} rel="noopener" target="_blank"{% endif %}>
    <span class="featured-body">
      <span class="featured-title">{{ item.data.title }}{% if item.data.external %} <span class="ext" aria-hidden="true">↗︎</span>{% endif %}</span>
      {%- if item.data.description %}
      <span class="featured-lede">{{ item.data.description }}</span>
      {%- endif %}
      <span class="featured-meta">
        {%- if item.data.categories.length %}<span class="post-row-cat">{{ item.data.categories[0] | categoryLabel }}</span> · {% endif -%}
        {{ item.date | readableDate }} · {{ item.templateContent | readingTime }} min read
      </span>
    </span>
    {#- `thumb` fills this slot for a post that carries its own visual in the
        body and would only repeat it at the top of the article. #}
    {%- set featuredImage = item.data.cover or item.data.thumb %}
    {%- if featuredImage %}
    {#- Both sit above the fold, so both load eagerly — lazy on the second made
        it pop in on every load. Only the first carries the LCP hint, so the
        priority is not split between them. #}
    <img class="featured-cover-img" src="{{ featuredImage }}" alt="{{ item.data.title }}"
         loading="eager" {% if loop.first %}decoding="sync" fetchpriority="high"{% else %}decoding="async"{% endif %}>
    {%- endif %}
  </a>
  {%- endfor %}
  {%- set posts = collections.posts | limit(16) | skip(2) %}
  {% include "post-list.njk" %}
  <p class="index-more"><a href="/blog/">Full index, {{ collections.posts.length }} posts →</a></p>
</section>

{%- if collections.notes.length %}
<section class="container home-section">
  <h2 class="rule-heading">Notes</h2>
  <ul class="post-list">
    {%- for note in collections.notes | limit(4) %}
    <li class="post-row">
      <a class="note-compact" href="{{ note.url }}">
        <span class="note-compact-row">
          {#- An untitled note is its own headline, so it fills the row alone. #}
          <span class="post-row-title">{{ note.data.title or (note.templateContent | excerpt | truncate(90)) }}</span>
          <span class="post-row-leader" aria-hidden="true"></span>
          <span class="post-row-meta">{{ note.date | readableDate }}</span>
        </span>
        {%- if note.data.title %}
        <span class="note-snippet">{{ note.templateContent | excerpt | truncate(130) }}</span>
        {%- endif %}
      </a>
    </li>
    {%- endfor %}
  </ul>
  <p class="index-more"><a href="/notes/">All notes →</a></p>
</section>
{%- endif %}

<section class="container home-section">
  <h2 class="rule-heading">Projects</h2>
  <ul class="project-index">
    {%- for item in building %}
    <li>
      <a href="{{ item.url }}" rel="noopener" target="_blank">{{ item.name }} <span class="ext" aria-hidden="true">↗︎</span></a>
      <span class="project-desc">{{ item.desc | truncate(90) }}</span>
    </li>
    {%- endfor %}
    {%- for post in collections.categoryMap | categoryPosts("projects") %}
    <li>
      <a href="{{ post.url }}">{{ post.data.title }}</a>
      <span class="project-desc">{{ post.templateContent | excerpt | truncate(90) }}</span>
    </li>
    {%- endfor %}
  </ul>
</section>
