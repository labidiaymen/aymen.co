---
layout: layouts/base.njk
---
<section class="container home-intro">
  <h1 class="intro-name">Labidi Aymen</h1>
  <p class="intro-role">Architect &amp; Engineering Manager @Inetum · Founder of Nuraly · Tunisia</p>
  <div class="intro-prose">
    <p>
      Building for the web since 2010. I lead a team of 20 at Inetum and write
      here about running <a href="/ai/">AI&nbsp;agents in production</a>,
      beyond the demo.
    </p>
  </div>
  <p class="intro-currently">
    Currently: building <a href="https://joule.sh/" rel="noopener" target="_blank">Joule</a>, an agent AI platform
    · <a href="https://lumen-lang.org/" rel="noopener" target="_blank">Lumen</a>, a TypeScript-syntax language
    that compiles to a native binary
    · shipping code with AI agents at <a href="/ai/nuraly-how-we-ship-code-with-ai-agents/">Nuraly</a>
  </p>
</section>

<section class="container home-section">
  <h2 class="rule-heading">Writing</h2>
  {%- set latest = collections.posts | first %}
  <a class="featured-item" href="{{ latest.data.external or latest.url }}"{% if latest.data.external %} rel="noopener" target="_blank"{% endif %}>
    <span class="featured-body">
      <span class="featured-title">{{ latest.data.title }}{% if latest.data.external %} <span class="ext" aria-hidden="true">↗</span>{% endif %}</span>
      {%- if latest.data.description %}
      <span class="featured-lede">{{ latest.data.description }}</span>
      {%- endif %}
      <span class="featured-meta">
        {%- if latest.data.categories.length %}<span class="post-row-cat">{{ latest.data.categories[0] | categoryLabel }}</span> · {% endif -%}
        {{ latest.date | readableDate }} · {{ latest.templateContent | readingTime }} min read
      </span>
    </span>
    {%- if latest.data.cover %}
    <img class="featured-cover-img" src="{{ latest.data.cover }}" alt="" loading="lazy">
    {%- endif %}
  </a>
  {%- set posts = collections.posts | limit(16) | skipFirst %}
  {% include "post-list.njk" %}
  <p class="index-more"><a href="/blog/">Full index, {{ collections.posts.length }} posts →</a></p>
</section>

{%- if collections.notes.length %}
<section class="container home-section">
  <h2 class="rule-heading">Notes</h2>
  <div class="note-stream">
    {%- for note in collections.notes | limit(3) %}
    <article class="note-entry">
      <a class="note-date" href="{{ note.url }}">
        <time datetime="{{ note.date | isoDate }}">{{ note.date | readableDate }}</time>
      </a>
      <div class="note-body prose">
        {{ note.templateContent | safe }}
      </div>
    </article>
    {%- endfor %}
  </div>
  <p class="index-more"><a href="/notes/">All notes →</a></p>
</section>
{%- endif %}

<section class="container home-section">
  <h2 class="rule-heading">Projects</h2>
  <ul class="project-index">
    {%- for item in building %}
    <li>
      <a href="{{ item.url }}" rel="noopener" target="_blank">{{ item.name }} <span class="ext" aria-hidden="true">↗</span></a>
      <span class="project-desc">{{ item.desc | truncate(90) }}</span>
    </li>
    {%- endfor %}
    {%- for post in collections.categoryMap | categoryPosts("projects") %}
    <li>
      <a href="{{ post.url }}">{{ post.data.title }}</a>
      <span class="project-desc">{{ post.templateContent | excerpt | truncate(90) }}</span>
    </li>
    {%- endfor %}
  </ul>
</section>
